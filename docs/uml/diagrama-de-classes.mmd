classDiagram
    direction TB

    class UserModel {
        -Long id
        -String name
        -int level
        -int xp
        -List~UserMediaModel~ shelf
        +addXp(int amount) void
        +getLevel() int
        +getShelf() List~UserMediaModel~
        +addToShelf(UserMediaModel userMediaModel) void
        +removeFromShelf(UserMediaModel userMediaModel) void
    }

    class UserMediaModel {
        -Long id
        -UserModel user
        -MediaModel media
        -int progress
        -int rewardedProgress
        -Double rating
        -ReadingStatusEnum status
        +UserMediaModel(Long id, UserModel user, MediaModel media)
        +UserMediaModel(Long id, UserModel user, MediaModel media, int rewardedProgress)
        +getUser() UserModel
        +getMedia() MediaModel
        +getProgress() int
        +getRewardedProgress() int
        +setProgress(int progress) void
        +markRewardedProgress() void
        +setRating(double rating) void
        +setStatus(ReadingStatusEnum status) void
        +getProgressPercentage() double
    }

    class MediaModel {
        <<abstract>>
        -Long id
        -String title
        -String author
        -String genre
        -String description
        +getTotalUnits() int*
        +formatSize() String*
        +getXpCalculator() XPCalculator*
    }

    class BookModel {
        -XPCalculator XP_CALCULATOR$
        -int quantityPages
        +getTotalUnits() int
        +formatSize() String
        +getXpCalculator() XPCalculator
    }

    class AudioBookModel {
        -XPCalculator XP_CALCULATOR$
        -int durationSeconds
        +getTotalUnits() int
        +formatSize() String
        +getXpCalculator() XPCalculator
    }

    class ReadingStatusEnum {
        <<enumeration>>
        PLANNED
        IN_PROGRESS
        COMPLETED
        DROPPED
    }

    class XPCalculator {
        <<interface>>
        +calculateXp(int previous, int current) int
    }

    class BookXPCalculator {
        +calculateXp(int previous, int current) int
    }

    class AudioBookXPCalculator {
        +calculateXp(int previous, int current) int
    }

    class LibraryService {
        +LibraryService()
        +addMedia(UserModel user, MediaModel media) UserMediaModel
        +updateProgress(UserMediaModel userMediaModel, int progress) void
        +rateMedia(UserMediaModel userMediaModel, double rating) void
        +changeStatus(UserMediaModel userMediaModel, ReadingStatusEnum status) void
        +removeMedia(UserMediaModel userMediaModel) void
    }

    MediaModel <|-- BookModel
    MediaModel <|-- AudioBookModel
    XPCalculator <|.. BookXPCalculator
    XPCalculator <|.. AudioBookXPCalculator
    UserModel "1" *-- "0..*" UserMediaModel : possui
    UserMediaModel "0..*" --> "1" MediaModel : referencia
    UserMediaModel --> ReadingStatusEnum : utiliza
    LibraryService ..> UserMediaModel : gerencia
    LibraryService ..> UserModel : atualiza estante e XP
    LibraryService ..> MediaModel : pede estratégia
    LibraryService ..> XPCalculator : calcula XP
    MediaModel ..> XPCalculator : fornece estratégia
    BookModel ..> BookXPCalculator : fornece
    AudioBookModel ..> AudioBookXPCalculator : fornece
